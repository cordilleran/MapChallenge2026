# Copy to a file outside the repo, fill in your paths, then: set -a; . ./your.env; set +a; day-01/run_day01.sh
MC26_DATA=/path/to/day01-working-folder          # derived files are written here (created if missing)
MC26_GRASS_LOC=/path/to/grassdata/your_location  # GRASS location in EPSG:3005 holding the DEM mapset
MC26_DEM=your_dem@your_mapset                     # 30 m DEM covering the basin, inside that location
MC26_FWA=/path/to/fwa_stream_networks_ketl.geojson
MC26_BC50K=/path/to/bc_watersheds_50k_kettle.gpkg
MC26_3DHP=/path/to/3dhp_flowlines_region.gpkg      # needs a layer named flowline
# Optional
# MC26_MAPSET=mapchallenge2026   MC26_TAG=_a15   MC26_MINAREA=1.5   MC26_MOUTH=-118.1089,48.6629   MC26_RELIEF=superior (or dark)
