# Day 4 inputs (copy to .env or export before running the scripts)
# GOES-17 GLM L2 LCFA files, 30 Jun 20:00 to 1 Jul 09:00 UTC 2021, laid out as <doy>/<hour>/*.nc
MC26_GLM_DIR=/path/to/goes17_glm/2021
# ERA5 files written by 01_fetch_era5.py
MC26_ERA5_DIR=/path/to/era5
MC26_DAY04_RAW=/path/to/day-04-raw   # cache for terrain tiles and Natural Earth downloads (04_basemap.py)
