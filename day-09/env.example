# Day 9 configuration: copy to .env (gitignored) and `set -a; . ./.env; set +a` before running the scripts.

# Working folder for the DuckDB store, raw downloads (raw-YYMMDD/) and derived files
MC26_DAY09_DIR=/path/to/day-09-data

# The library: one folder per record, a Markdown note with YAML frontmatter and <id>.source.md
MC26_LIBRARY=/path/to/library/records

# GeoNames download folder (allCountries.txt, countryInfo.txt, admin1CodesASCII.txt)
MC26_GEONAMES=/path/to/geonames

# Contact address for the OpenAlex polite pool
MC26_CONTACT=you@example.org
