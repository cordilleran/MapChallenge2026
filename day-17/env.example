# Copy to a file outside the repo, fill in your paths, then: set -a; . ./your.env; set +a
MC26_DAY17_DATA=/path/to/day17-working-folder   # holds raw/ (GEM-15 crops), us/ (US LiDAR) and derived/ (written)
MC26_LIDAR_BC=/path/to/bc-lidar-cogs           # lidar2025_{dsm,dem}_grandforks_buffer1_cog.tif: LidarBC 2025, 1 m
MC26_GEONAMES=/path/to/allCountries.txt        # GeoNames dump, for the peak and town labels
# Optional
# MC26_PDAL=pdal                                 # PDAL binary for s1b (US EPT tiles)
# MC26_PY=python3                                # the Day 17 environment (requirements.txt)
