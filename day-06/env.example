# Day 6 settings. Copy to day-06/.env and load with: set -a; . ./.env; set +a
# Folder for downloads (raw-YYMMDD/) and derived layers. Kept outside the repository.
MC26_DAY06_DIR=/path/to/day-06
# The scanned sheet: the 600 ppi TIFF master of https://archive.org/details/AB-BC-sheet16 (the item's
# AB-BC-sheet16_images.zip). The 2315 px JPEG also works; control points scale to either.
MC26_SHEET16=/path/to/AB-BC-sheet16.tif
# Optional: where QGIS is installed, if not under /usr (step 07).
# QGIS_PREFIX_PATH=/usr
