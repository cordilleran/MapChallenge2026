# Copy to a file outside the repo, fill in your paths, then: set -a; . ./your.env; set +a; day-02/run_day02.sh
MC26_DAY02_DATA=/path/to/day02-working-folder    # derived files are written here (created if missing)
MC26_FWA=/path/to/fwa_stream_networks_ketl.geojson  # BC Freshwater Atlas stream network, watershed group KETL
MC26_DEM_TIF=/path/to/dem_30m_bcalbers.tif       # 30 m DEM in EPSG:3005 covering the basin
# Optional
# MC26_BASIN_CODE=300-571168-245886 (Granby River)   MC26_WINDOW=2000 (m)
