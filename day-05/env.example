# Day 5 configuration (copy to .env or export before running pipeline scripts)

# Data root folder holding all Day 5 inputs and intermediate datasets
MC26_DAY05_DIR=/path/to/day-05-in

# Folder for Mountain Legacy Project station and location JSON records (00_fetch_mlp.py, 01_stations.py)
MC26_MLP_LOCATIONS_DIR=/path/to/day-05-in/mlp_locations

# Root folder for slice (a) data preparation outputs (raw/ and derived/)
MC26_SLICE_A_DIR=/path/to/day-05-in/slice_a

# Path to the 30 m viewshed-box DEM GeoTIFF (EPSG:3979)
MC26_DEM_PATH=/path/to/day-05-in/slice_a/derived/dem_viewshed_30m_epsg3979.tif

# Path to the 30 m forest mask GeoTIFF (ESA WorldCover fraction >= 0.5)
MC26_FOREST_MASK_PATH=/path/to/day-05-in/slice_a/derived/forest_mask_viewshed_30m_epsg3979.tif

# Path to the surveyed camera stations CSV table
MC26_STATIONS_CSV=/path/to/day-05-in/slice_a/stations.csv

# Path to the viewshed and core bounding box metadata JSON
MC26_BOXES_META=/path/to/day-05-in/slice_a/derived/boxes_meta.json

# Path to the gazetteer peaks and passes GeoJSON (CGNDB + GNIS)
MC26_PEAKS_PATH=/path/to/day-05-in/slice_a/names_peaks_passes.geojson

# Output directory for slice (b) viewsheds and metrics (09_viewsheds.py, 10_probable_viewsheds.py, 11_checks_and_plots.py)
MC26_VIEWSHEDS_DIR=/path/to/day-05-in/viewsheds

# Output directory for the 8.0 m RMSE probable viewshed Monte Carlo run
MC26_VIEWSHEDS_RMSE8_DIR=/path/to/day-05-in/viewsheds_rmse8

# Folder containing rendered 300 dpi grayscale thesis PDF pages (page-093.png to page-100.png)
MC26_THESIS_PAGES_DIR=/path/to/day-05-in/thesis_pages

# Output directory for cropped plate photos, contact sheet, and crop metadata (12_crop_thesis_plates.py)
MC26_PHOTOS_DIR=/path/to/day-05-in/photos

# Path to verified Mountain Legacy Project plate manifest JSON (optional)
MC26_MLP_MANIFEST=/path/to/day-05-in/mlp_manifest.json

# Output directory for 360-degree simulated panoramas, skylines, and fitted plate wedges (17_render_panoramas.py, 18_fit_wedges.py)
MC26_PANO_DIR=/path/to/day-05-in/pano

# Input directory for 17_render_panoramas.py (defaults to $MC26_DAY05_DIR/slice_a/derived)
D5_PANO_IN=/path/to/day-05-in/slice_a/derived

# Output base directory for 17_render_panoramas.py (writes into {D5_PANO_OUT}/pano)
D5_PANO_OUT=/path/to/day-05-in

# Viewshed directory for line-of-sight visibility check in 17_render_panoramas.py
D5_VS_DIR=/path/to/day-05-in/viewsheds

# Set to 1 to burn peak labels into rendered panorama images (0 = page renders labels dynamically)
PANO_LABELS=0

# Local cache directory for full-frame Sentinel-2 viewshed mosaics (19_satellite_landcover.py)
MC26_S2FULL_DIR=/path/to/day-05-in/s2full

# Python interpreter executable used by shell scripts
PYTHON=python3

# Parallel worker process count for GRASS GIS viewshed computations
WORKERS=20

# Observer position and fonts (D93, D97)
D5_PANO_POSITION=station                                   # 17: "station" (recorded point) or "highpoint" (writes the _hp files)
MC26_VIEWSHEDS_HP_DIR=${MC26_DAY05_DIR}/viewsheds_highpoint  # 09 --position highpoint output; read by 20
D5_PANO_HP_DIR=${MC26_DAY05_DIR}/pano                      # 20: folder with pano_<stn>[_hp]*.webp and skyline_<stn>[_hp].json
D5_WEDGE_HALF_WIDTH=180                                    # 18: search half-width in degrees around the recorded bearing (180 = full circle)
D5_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf    # 17 and 18: label font (falls back to a built-in font)
D5_FONT_BOLD=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
